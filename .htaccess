RewriteEngine On

# 301 Redirect: Force HTTPS and non-www (Single-hop canonical for ssdprayas.com)
RewriteCond %{HTTP_HOST} ^www\.ssdprayas\.com$ [NC,OR]
RewriteCond %{HTTP_HOST} ^ssdprayas\.com$ [NC]
RewriteCond %{HTTPS} off
RewriteRule ^ https://ssdprayas.com%{REQUEST_URI} [R=301,L]

RewriteCond %{HTTP_HOST} ^www\.ssdprayas\.com$ [NC]
RewriteRule ^ https://ssdprayas.com%{REQUEST_URI} [R=301,L]

# Force extensionless, index-free URLs.
# GET only — redirecting a POST would drop the form data.
# The admin panel keeps its .php URLs.
RewriteCond %{REQUEST_URI} !adminpanelweb
RewriteCond %{THE_REQUEST} ^GET\s(.*)/index\.php [NC]
RewriteRule ^ %1 [R=301,L]

RewriteCond %{REQUEST_URI} !adminpanelweb
RewriteCond %{THE_REQUEST} ^GET\s([^.]+)\.php [NC]
RewriteRule ^ %1 [R=301,L]

# Search engines ask for /sitemap.xml — serve the generated one.
RewriteRule ^sitemap\.xml$ sitemap.php [L]

# Blog detail: /blog/my-post-slug -> blog-detail.php?slug=my-post-slug
RewriteRule ^blog/([A-Za-z0-9_-]+)/?$ blog-detail.php?slug=$1 [L,QSA]

# Map extensionless URLs to their .php file
RewriteCond %{REQUEST_URI} !adminpanelweb
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^(.*?)/?$ $1.php [L]

# Keep config, includes and backups off the web
<FilesMatch "^(config\.php|config\.local\.php|config\.server\.php)$">
    Require all denied
</FilesMatch>

# Basic security headers & browser caching
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    <FilesMatch "\.(ico|jpg|jpeg|png|gif|webp|svg|css|js|woff|woff2)$">
        Header set Cache-Control "max-age=2592000, public"
    </FilesMatch>
</IfModule>

# Cache static assets
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/png  "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType text/css   "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# GZIP compression for text, css, js, json, svg
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json image/svg+xml
</IfModule>
